---
const { name, avatar, url, bio } = Astro.props;
---

<a
	href={url}
	class="hover:shadow-ui-background-secondary relative max-w-full overflow-hidden rounded-3xl border transition hover:shadow-md active:scale-[99%]">
	<div class="relative z-1 flex flex-row items-center gap-4 p-4">
		<img class="h-24 w-24 flex-none rounded-xl" src={avatar} />
		<div class="flex flex-col flex-wrap justify-center">
			<span class="text-2xl font-extrabold tracking-tight sm:text-3xl">{name}</span>
			<span class="line-clamp-3">{bio}</span>
		</div>
	</div>
	<div
		class="cardbg absolute top-0 left-0 h-full w-full rounded-3xl bg-cover bg-center bg-no-repeat object-cover blur-[5vh]"
		style={{ backgroundImage: `url(${avatar})` }}>
	</div>
</a>
