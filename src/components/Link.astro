---
interface Props {
	href: string;
	class?: string;
}

const { href, class: className }: Props = Astro.props;
---

<div class={className}>
	<a
		href={href}
		class="bg-linear-to-r from-brand-text to-brand-text bg-size-[0%_2px] bg-bottom-left bg-no-repeat transition-all duration-300 ease-in-out hover:bg-size-[100%_2px]">
		<slot />
	</a>
</div>
