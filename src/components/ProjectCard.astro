---
const { title, summary, icon, gallery, slug } = Astro.props;
let featuredImage = "";
for (let i = 0; i < gallery.length; i++) {
	if (gallery[i].featured === true) {
		featuredImage = gallery[i].url;
	}
}
---

<a
	href={slug ? `/project/${slug}` : "https://github.com/spiritgamestudios"}
	class="hover:shadow-ui-background-secondary relative rounded-3xl border transition hover:shadow-md active:scale-[99%]">
	<div class="relative z-1 flex flex-row items-center gap-4 p-6">
		<img class="h-24 w-24 flex-none rounded-xl" src={icon ?? "undefined"} />
		<div class="flex flex-col justify-center">
			<span class="text-4xl font-extrabold tracking-tight sm:text-5xl">{title ?? "Undefined"}</span>
			<span class="text-lg sm:text-xl">{summary ?? "undefined"}</span>
		</div>
	</div>
	<div
		class="cardbg absolute top-0 left-0 z-0 h-full w-full rounded-3xl bg-cover bg-center bg-no-repeat object-cover"
		style={{ backgroundImage: `url(${featuredImage})` }}>
	</div>
</a>
