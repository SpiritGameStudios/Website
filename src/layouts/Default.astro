---
import "../styles/global.css";
import "@fontsource-variable/atkinson-hyperlegible-next/wght.css";
import "@fontsource-variable/atkinson-hyperlegible-next/wght-italic.css";

import "@components/Logotype.astro";
import { Icon } from "astro-icon/components";
import Logotype from "../components/Logotype.astro";
import Level from "@components/interactive/Level.svelte";

let { title } = Astro.props;

title = title === "" || title === undefined ? "Spirit Studios" : `${title} ◊ Spirit Studios`;
---

<!doctype html>
<html
	style=`background-image: url(/assets/textures/layout/background_tile.png)`
	class="text-ui-text rendering-pixelated h-full bg-repeat">
	<head>
		<title>{title}</title>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="title" content="Home - Spirit Studios" />
		<meta
			name="description"
			content="Spirit Studios is a small Minecraft modding group that makes high-quality and fun mods for Fabric."
		/>
		<meta name="keywords" content="minecraft,fabric,mod,spirit,spiritstudios" />
		<meta name="robots" content="index" />
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
		<meta name="language" content="English" />
		<meta name="author" content="Spirit Studios" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Spirit Studios" />
		<meta property="og:url" content="https://spiritstudios.dev" />
		<meta property="og:image" content="https://spiritstudios.dev/og.png" />
		<meta property="twitter:card" content="summary_large_image" />
		<meta
			property="og:description"
			content="Spirit Studios is a small Minecraft modding group that makes high-quality and fun mods for Fabric."
		/>
		<meta name="theme-color" content="#8400ff" />
	</head>
	<body class="flex h-auto flex-col xl:h-dvh">
		<div class="flex h-dvh flex-auto flex-col">
			<nav class="flex w-full flex-row justify-center p-2">
				<div class="layout-header-nine-slice grid w-full max-w-5xl grid-cols-2 gap-4">
					<div class="flex h-full flex-row items-center justify-start gap-2 font-bold">
						<a class="px-8 py-6" href="/">
							<Logotype />
						</a>
					</div>
					<div class="text-ui-text-strong flex flex-row justify-end gap-2 gap-x-6 px-8 py-6 text-lg">
						<a href="/projects">Projects</a>
						<a href="/people">People</a>
					</div>
				</div>
			</nav>
			<main class="flex w-full flex-auto flex-row items-center justify-center px-2 pb-2 xl:flex-initial">
				<div class="layout-main-nine-slice h-full w-full max-w-5xl px-8 py-8">
					<slot />
				</div>
			</main>
		</div>
		<footer class="flex w-full flex-col items-center px-2">
			<div class="layout-footer-nine-slice flex w-full max-w-5xl flex-col">
				<span class="px-2">
					<Level class="pt-12" blockSize={16} client:load />
				</span>
				<div class="bg-ui-background-secondary border-x-8 border-[#1a2323] p-6">
					<span class="flex flex-row gap-0">
						Made with <Icon name="lucide:heart" class="m-1" /> by Spirit Studios.
					</span>
				</div>
			</div>
		</footer>
	</body>
</html>
